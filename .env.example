# Copy to .env and adjust as needed. docker-compose reads this automatically.

# Postgres (used by both the db service and the api service's DATABASE_URL)
POSTGRES_USER=tospec
POSTGRES_PASSWORD=tospec
POSTGRES_DB=tospec

# Full async SQLAlchemy connection string used by the API
DATABASE_URL=postgresql+asyncpg://tospec:tospec@db:5432/tospec

# Comma-separated list of allowed CORS origins. "null" allows fetch() calls
# made from file:// pages (most browsers send Origin: null for those).
CORS_ORIGINS=http://localhost,http://localhost:5500,http://127.0.0.1:5500,null

# Upload limits
MAX_FILE_SIZE_MB=15
MAX_BATCH_FILES=30

# slowapi rate limit applied per-IP to /resize and /resize/batch
RATE_LIMIT_RESIZE=20/minute
